# --- Máy chủ ---
PORT=3000
NODE_ENV=development

# --- Phiên đăng nhập ---
# Bắt buộc, tối thiểu 32 ký tự. Server từ chối khởi động nếu thiếu.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=2h

# --- AI (Google Gemini) ---
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODEL=gemini-3.5-flash-lite
# true = chạy offline bằng mockSearch, không gọi API thật.
ENABLE_MOCK_AI=false

# Dữ liệu lưu tại data/db.json — không cần cấu hình database.
